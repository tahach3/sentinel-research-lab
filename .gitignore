# Secrets
.env
.env.local
.env.*.local

# Database dumps and backups
backups/**
!backups/.gitkeep
*.sql.gz
*.dump
*.backup
# Ignore ad-hoc SQL dumps at repo root; allow versioned database SQL
/*.sql
!database/**/*.sql

# n8n credential-bearing exports (allow inactive design workflows only)
workflows/**
!workflows/.gitkeep
!workflows/design/
!workflows/design/*.json

# Generated proposal exports (commit only when explicitly approved later)
exports/**
!exports/.gitkeep

# Logs and temp
*.log
logs/
tmp/
temp/
.cache/

# Local Docker / IDE state
.docker/
.idea/
.vscode/
*.swp
Thumbs.db
Desktop.ini

# OS
.DS_Store

# Script scratch
*.bak
*.bak-sentinel
