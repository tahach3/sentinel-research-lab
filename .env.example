# SENTINEL Research Lab — example environment (placeholders only)
# Copy to .env and replace all CHANGE_ME values. Never commit .env.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_ADMIN_PASSWORD
POSTGRES_DB=sentinel_research_lab

N8N_DB_USER=n8n_app
N8N_DB_PASSWORD=CHANGE_ME_N8N_DB_PASSWORD

RESEARCH_DB_USER=research_app
RESEARCH_DB_PASSWORD=CHANGE_ME_RESEARCH_DB_PASSWORD

N8N_ENCRYPTION_KEY=CHANGE_ME_N8N_ENCRYPTION_KEY_32PLUS_CHARS

# Optional timezone
GENERIC_TIMEZONE=Asia/Karachi
TZ=Asia/Karachi

# --- Option A srl-worker (host-side values only) ---
# Reviewed checkout on the host (bind-mounted RO into the container).
SRL_REPOSITORY_ROOT=/absolute/path/to/sentinel-research-lab
SRL_REVIEWED_HEAD=REPLACE_WITH_40_LOWERCASE_HEX_HEAD
# Durable host directory for /srl/state (sqlite ledger), NOT Zone P throwaway.
SRL_STATE_DIR=/absolute/path/to/srl-state
# Host paths to secret files (compose secrets:). In-container destinations remain
# /run/secrets/srl_worker_token and /run/secrets/srl_topology_consume_token.
SRL_WORKER_TOKEN_HOST_FILE=/absolute/path/to/srl_worker_token
SRL_TOPOLOGY_CONSUME_TOKEN_HOST_FILE=/absolute/path/to/srl_topology_consume_token
# Optional dedicated Docker volume name for /tmp/srl-exec
# SRL_EXEC_VOLUME_NAME=srl-exec-local
