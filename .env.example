# SENTINEL Research Lab — example environment (placeholders only)
# Copy to .env and replace all CHANGE_ME values. Never commit .env.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_ADMIN_PASSWORD
POSTGRES_DB=sentinel_research_lab

N8N_DB_USER=n8n_app
N8N_DB_PASSWORD=CHANGE_ME_N8N_DB_PASSWORD

RESEARCH_DB_USER=research_app
RESEARCH_DB_PASSWORD=CHANGE_ME_RESEARCH_DB_PASSWORD

N8N_ENCRYPTION_KEY=CHANGE_ME_N8N_ENCRYPTION_KEY_32PLUS_CHARS

# Optional timezone
GENERIC_TIMEZONE=Asia/Karachi
TZ=Asia/Karachi
