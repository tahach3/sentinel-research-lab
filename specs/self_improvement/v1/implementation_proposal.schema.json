{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sentinel-research-lab.local/self_improvement/v1/implementation_proposal.schema.json",
  "title": "Self-Improvement Implementation Proposal",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "proposal_id",
    "candidate_id",
    "repository",
    "baseline_sha",
    "objective",
    "evidence_refs",
    "allowed_paths",
    "forbidden_paths",
    "patches",
    "validation_profile",
    "acceptance_criteria",
    "risk_level",
    "rollback_strategy",
    "human_approval_required"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "proposal_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "candidate_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "repository": {
      "type": "string",
      "const": "sentinel-research-lab"
    },
    "baseline_sha": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "objective": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      }
    },
    "allowed_paths": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 260
      }
    },
    "forbidden_paths": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 260
      }
    },
    "patches": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "operation",
          "unified_diff",
          "expected_preimage_sha256",
          "expected_postimage_sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 260,
            "pattern": "^[^\\\\].*$"
          },
          "operation": {
            "type": "string",
            "enum": ["CREATE", "MODIFY", "DELETE"]
          },
          "unified_diff": {
            "type": "string",
            "minLength": 1,
            "maxLength": 204800
          },
          "expected_preimage_sha256": {
            "type": "string",
            "pattern": "^([a-f0-9]{64}|)$"
          },
          "expected_postimage_sha256": {
            "type": "string",
            "pattern": "^([a-f0-9]{64}|)$"
          }
        }
      }
    },
    "validation_profile": {
      "type": "string",
      "enum": [
        "SELF_IMPROVEMENT_TESTS",
        "DOCUMENTATION_ONLY",
        "PYTHON_TOOLING",
        "WORKFLOW_DESIGN_STATIC"
      ]
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      }
    },
    "risk_level": {
      "type": "string",
      "enum": ["LOW", "MEDIUM", "HIGH", "PROHIBITED"]
    },
    "rollback_strategy": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "human_approval_required": {
      "type": "boolean"
    },
    "implementer_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "repair_attempt": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1
    }
  }
}
