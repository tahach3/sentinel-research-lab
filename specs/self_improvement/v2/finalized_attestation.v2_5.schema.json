{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "srl.finalized_attestation.v2_5",
  "title": "FINALIZED_ATTESTATION",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "execution_id",
    "reviewed_head",
    "authorized_baseline",
    "candidate_commit",
    "candidate_tree",
    "srl_candidate_ref",
    "finalization_result_sha256",
    "sealed_inventory_sha256",
    "sealed_artifact_hashes",
    "staging_generation",
    "worker_container_id",
    "worker_started_at",
    "worker_image_digest",
    "worker_netns_identity",
    "n8n_container_id",
    "topology_attestation_identity",
    "topology_attestation_sequence",
    "launcher_observation_sequence",
    "observed_unix_ts",
    "attestation_sha256"
  ],
  "properties": {
    "schema_version": { "const": "srl.finalized_attestation.v2_5" },
    "execution_id": { "type": "string", "pattern": "^[a-f0-9]{32}$" },
    "reviewed_head": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "authorized_baseline": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "candidate_commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "candidate_tree": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "srl_candidate_ref": { "const": "refs/heads/srl-candidate" },
    "finalization_result_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "sealed_inventory_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "sealed_artifact_hashes": { "type": "object" },
    "staging_generation": { "type": "string", "pattern": "^[a-f0-9]{8}$" },
    "worker_container_id": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "worker_started_at": { "type": "string", "minLength": 1 },
    "worker_image_digest": { "type": "string" },
    "worker_netns_identity": { "type": "string", "minLength": 1 },
    "n8n_container_id": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "topology_attestation_identity": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "topology_attestation_sequence": { "type": "integer" },
    "launcher_observation_sequence": { "type": "integer" },
    "observed_unix_ts": { "type": "integer" },
    "attestation_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
