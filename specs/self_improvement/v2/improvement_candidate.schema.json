{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sentinel-research-lab.local/self_improvement/v2/improvement_candidate.schema.json",
  "title": "Self-Improvement V2 Improvement Candidate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "candidate_id",
    "repository_id",
    "problem",
    "evidence",
    "expected_benefit",
    "success_metrics",
    "risk_indicators",
    "source_agent",
    "created_from_run"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "2.0.0"
    },
    "candidate_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "repository_id": {
      "type": "string",
      "const": "sentinel-research-lab"
    },
    "problem": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      }
    },
    "expected_benefit": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "success_metrics": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      }
    },
    "risk_indicators": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      }
    },
    "source_agent": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "created_from_run": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    }
  }
}
