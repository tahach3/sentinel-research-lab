{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sentinel-research-lab.local/self_improvement/v2/learning_record.schema.json",
  "title": "Self-Improvement V2 Learning Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "learning_id",
    "candidate_id",
    "proposal_id",
    "execution_id",
    "proposal_sha256",
    "execution_result_sha256",
    "problem",
    "research_summary",
    "implementation_summary",
    "validation_summary",
    "review_findings",
    "repair_attempts",
    "final_outcome",
    "reusable_patterns",
    "failure_patterns",
    "confidence",
    "promotion_status"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "2.0.0"
    },
    "learning_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "candidate_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "proposal_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "execution_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "proposal_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "execution_result_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "problem": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "research_summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "implementation_summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "validation_summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "review_findings": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      }
    },
    "repair_attempts": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1
    },
    "final_outcome": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "reusable_patterns": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      }
    },
    "failure_patterns": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "promotion_status": {
      "type": "string",
      "enum": [
        "READY_FOR_HUMAN_PROMOTION",
        "BLOCKED",
        "FAILED_FROZEN",
        "DECISION_REQUIRED",
        "NOT_PROMOTED"
      ]
    }
  }
}
